# LiveKit project. `lk app create` can fill these in.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# VLM Run key. The agent holds it; the browser never sees it.
VLMRUN_API_KEY=

# Realtime socket. Each message after session.create is one frame.
VLMRUN_GATEWAY_WS=wss://gateway.vlm.run/v1/ws

# A model with a realtime block. A generative chat model is refused here.
VLMRUN_MODEL=usyd-community/vitpose-plus-large
# pose for ViTPose and HaMeR. Leave empty to use the model's default.
VLMRUN_METHOD=pose
# Sent as the session prompt.
VLMRUN_PROMPT=

# Local cap. The session also enforces the model's max_fps.
VISION_FPS=8

# Room the demo page publishes into.
DEMO_ROOM=vlmrun-vision
